---
import AppButton from './AppButton.astro'
import logo from '../assets/images/logo-colored.png'

const productLinks = [
    { href: '/products/aesthefill', label: 'AestheFill', color: 'aesthefill', hoverClass:'hover:text-aesthefill'},
    { href: '/products/powerfill', label: 'Powerfill', color: 'powerfill',hoverClass:'hover:text-powerfill' },
    { href: '/products/juvegel', label: 'Juvegel', color: 'juvegel',hoverClass:'hover:text-juvegel' },
]

const links = [
    { href: '/', label: 'Home' },
    { href: '/products', label: 'Products', children: productLinks },
    { href: '/services', label: 'Services' },
    { href: '/contact', label: 'Contact us' },
]

const {navColor = "primary-orange"} = Astro.props;
---

<nav
    id="navbar"
    class="w-screen fixed left-0 top-0 z-70 transition-all duration-150 bg-bg shadow mx-auto md:px-10 px-4 py-8"
>
    <div class="w-full mx-auto">
        <div class="flex items-center lg:justify-center justify-end">
            <a href="/" class="flex absolute left-8 items-center gap-2 group">
                <img src={logo.src} alt="Bio Alpha logo" class="w-22 transition-all hover:scale-105 md:mr-2 mr-1" />
            </a>

            <div class="hidden text-lg lg:flex items-center justify-center gap-12">
                {links.map((link) =>
                    link.children ? (
                        <div class="relative group">
                            <a
                                href={link.href}
                                class="font-semibold inline-flex items-center gap-1.5 group-hover:text-primary-orange group-focus-within:text-primary-orange transition-colors duration-300"
                            >
                                {link.label}
                                <svg
                                    class="w-4 h-4 transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180"
                                    viewBox="0 0 20 20"
                                    fill="currentColor"
                                    aria-hidden="true"
                                >
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                </svg>
                            </a>

                            <div class="absolute left-1/2 -translate-x-1/2 top-full z-50 pt-6 invisible opacity-0 translate-y-2 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-200">
                                <div class="w-60 bg-white rounded-xl shadow-xl border border-gray-100 py-2 overflow-hidden">
                                    {link.children.map((child) => (
                                        <a
                                            href={child.href}
                                            class={`flex items-center gap-3 px-4 py-2.5 font-medium hover:bg-offwhite ${child.hoverClass} focus:bg-offwhite  outline-none transition-colors duration-200`}
                                        >
                                            <span class={`w-2.5 h-2.5 rounded-full bg-${child.color}`}></span>
                                            {child.label}
                                        </a>
                                    ))}
                                    {/* <a
                                        href={link.href}
                                        class="block mt-1 px-4 py-2.5 border-t border-slate-200 text-sm font-bold text-primary-orange hover:bg-offwhite focus:bg-offwhite outline-none transition-colors duration-200"
                                    >
                                        View all products
                                    </a> */}
                                </div>
                            </div>
                        </div>
                    ) : (
                        <a
                            href={link.href}
                            class="font-semibold hover:text-primary-orange transition-colors duration-300"
                        >
                            {link.label}
                        </a>
                    )
                )}

                <div class="flex absolute right-8 items-center gap-3">
                    <AppButton height="h-12" href="/contact" bgColor="bg-transparent" border textColor="text-primary-black" text="Contact Us" />
                </div>
            </div>

            <button
                id="menu-toggle"
                class="lg:hidden flex flex-col gap-1.5 p-2 right-4 relative rounded-lg hover:bg-gray-100 transition-colors duration-300"
                aria-label="Toggle menu"
                aria-expanded="false"
            >
                <span data-bar="top" class="w-6 h-0.5 bg-gray-600 transition-all duration-300"></span>
                <span data-bar="middle" class="w-6 h-0.5 bg-gray-600 transition-all duration-300"></span>
                <span data-bar="bottom" class="w-6 h-0.5 bg-gray-600 transition-all duration-300"></span>
            </button>
        </div>

        <div
            id="mobile-menu"
            class="lg:hidden block overflow-hidden transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] max-h-0 opacity-0"
        >
            <div class="flex flex-col gap-3 py-4 border-t border-slate-200">
                {links.map((link) =>
                    link.children ? (
                        <div>
                            <div class="flex items-center justify-between">
                                <a
                                    href={link.href}
                                    class="flex-1 text-gray-600 hover:text-primary-orange transition-colors duration-300 px-2 py-1.5"
                                    data-menu-link
                                >
                                    {link.label}
                                </a>
                                <button
                                    type="button"
                                    id="submenu-toggle"
                                    class="p-2 rounded-lg hover:bg-gray-100 transition-colors duration-300"
                                    aria-label="Toggle products menu"
                                    aria-expanded="false"
                                    aria-controls="submenu"
                                >
                                    <svg id="submenu-chevron" class="w-5 h-5 text-gray-600 transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                    </svg>
                                </button>
                            </div>

                            <div
                                id="submenu"
                                class="overflow-hidden transition-all duration-300 max-h-0 opacity-0"
                            >
                                <div class="flex flex-col ml-4 pl-3 border-l-2 border-primary-orange/40">
                                    {link.children.map((child) => (
                                        <a
                                            href={child.href}
                                            class="flex items-center gap-3 text-gray-600 hover:text-primary-orange transition-colors duration-300 px-2 py-2"
                                            data-menu-link
                                        >
                                            <span class={`w-2.5 h-2.5 rounded-full bg-${child.color}`}></span>
                                            {child.label}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ) : (
                        <a
                            href={link.href}
                            class="text-gray-600 hover:text-primary-orange transition-colors duration-300 px-2 py-1.5"
                            data-menu-link
                        >
                            {link.label}
                        </a>
                    )
                )}

                <div class="flex flex-col gap-2 pt-2 border-t border-slate-200/60">
                    <a
                        href="/contact"
                        class="inline-flex items-center justify-center px-5 py-2.5 bg-primary-orange text-white font-medium rounded-full transition-all duration-500 hover:brightness-105"
                        data-menu-link
                    >
                        Contact Us
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div
        id="scroll-progress"
        class={`absolute inset-x-0 bottom-0 h-1 z-20 origin-left bg-${navColor} will-change-transform`}
        style="transform: scaleX(0)"
        role="progressbar"
        aria-label="Page scroll progress"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
    ></div>
</nav>

<script>
    const scrollProgress = document.getElementById('scroll-progress') as HTMLElement
    const toggle = document.getElementById('menu-toggle') as HTMLButtonElement
    const menu = document.getElementById('mobile-menu') as HTMLElement
    const top = toggle.querySelector('[data-bar="top"]') as HTMLElement
    const middle = toggle.querySelector('[data-bar="middle"]') as HTMLElement
    const bottom = toggle.querySelector('[data-bar="bottom"]') as HTMLElement
    const subToggle = document.getElementById('submenu-toggle') as HTMLButtonElement
    const submenu = document.getElementById('submenu') as HTMLElement
    const subChevron = document.getElementById('submenu-chevron') as unknown as SVGElement

    let isMenuOpen = false
    let isSubOpen = false
    let ticking = false

    const set = (el: Element, classes: string, on: boolean) => {
        classes.split(' ').forEach((c) => el.classList.toggle(c, on))
    }

    const render = () => {
        if (!isMenuOpen) isSubOpen = false

        set(menu, 'max-h-[600px] opacity-100 mt-4', isMenuOpen)
        set(menu, 'max-h-0 opacity-0', !isMenuOpen)

        set(top, 'rotate-45 translate-y-2', isMenuOpen)
        set(middle, 'opacity-0', isMenuOpen)
        set(bottom, '-rotate-45 -translate-y-2', isMenuOpen)

        set(submenu, 'max-h-48 opacity-100', isSubOpen)
        set(submenu, 'max-h-0 opacity-0', !isSubOpen)
        set(subChevron, 'rotate-180', isSubOpen)

        toggle.setAttribute('aria-expanded', String(isMenuOpen))
        subToggle.setAttribute('aria-expanded', String(isSubOpen))
    }

    const updateProgress = () => {
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight
        const progress = scrollableHeight > 0 ? Math.min(window.scrollY / scrollableHeight, 1) : 0

        scrollProgress.style.transform = `scaleX(${progress})`
        scrollProgress.setAttribute('aria-valuenow', String(Math.round(progress * 100)))
        ticking = false
    }

    const onScroll = () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(updateProgress)
    }

    toggle.addEventListener('click', () => {
        isMenuOpen = !isMenuOpen
        render()
    })

    subToggle.addEventListener('click', () => {
        isSubOpen = !isSubOpen
        render()
    })

    document.querySelectorAll('[data-menu-link]').forEach((link) => {
        link.addEventListener('click', () => {
            isMenuOpen = false
            render()
        })
    })

    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)
    updateProgress()
    render()
</script>