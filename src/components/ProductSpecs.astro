---
<section class="m-auto w-full lg:max-w-7xl ">
    {(specs && specs.length > 0) ? (
        <div class="w-full flex flex-col gap-4">
            <h2 class="text-3xl font-bold mb-4" style={`color: var(--color-${color}, currentColor);`}>Product Specifications</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
                {specs.map((spec: Spec,ind) => {
                    const icon = colorizeIcon(iconsMap[spec.name as keyof typeof iconsMap] ?? typeIcon);

                    return (
                            <Reveal
        animation="fade-right"
        // delay={200}
        // stagger={100}
        delay={ind*50}
        // threshold={0.5}
        >
                        <div
                            class="spec-card min-w-0 bg-white group rounded-2xl border border-current p-4 sm:p-6 flex flex-col justify-between h-full"
                            style={`--spec-color: var(--color-${color}, currentColor); --spec-border: var(--color-${color}, currentColor);`}
                        >
                            <div class="flex items-center mb-2 min-w-0">
                                <span
                                    class="spec-card__icon inline-flex w-6 h-6 shrink-0 mr-2 [&>svg]:w-full [&>svg]:h-full"
                                    set:html={icon}
                                    aria-hidden="true"
                                />
                                <h3 class="spec-card__title min-w-0 text-lg font-bold">{spec.name}</h3>
                            </div>
                            <p class="spec-card__value text-gray-700 font-medium">{spec.value}</p>
                        </div>
                        </Reveal>
                    );
                })}
            </div>
        </div>
    ) : (
        <p class="text-center text-gray-500 py-12">No specifications available.</p>
    )}
</section>

<style>
    .spec-card {
        border-color: var(--spec-border, currentColor);
        transition: transform 0.3s ease, background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .spec-card:hover {
        transform: translateY(-8px);
        background-color: var(--spec-color, currentColor);
        border-color: var(--spec-color, currentColor);
        box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.2);
    }

    .spec-card__icon,
    .spec-card__title,
    .spec-card__value {
        transition: color 0.3s ease;
    }

    .spec-card__icon,
    .spec-card__title {
        color: var(--spec-color, currentColor);
    }

    .spec-card__value {
        color: #4b5563;
    }

    .spec-card:hover .spec-card__icon,
    .spec-card:hover .spec-card__title,
    .spec-card:hover .spec-card__value {
        color: white;
    }
</style>