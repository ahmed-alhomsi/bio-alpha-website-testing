---
interface Props {
  src: string;
  alt: string;
  zoom?: number;
  lightbox?: boolean;
  class?: string;
  wrapperClass?: string;
}

const {
  src,
  alt,
  zoom = 2,
  lightbox = true,
  class: className = "",
  wrapperClass = "",
} = Astro.props;
---

<div
  class:list={["zoom-frame", wrapperClass]}
  style={`--zoom:${zoom}`}
  data-zoom
>
  {
    lightbox ? (
      <button
        type="button"
        class="zoom-open"
        data-zoom-open
        aria-label={`View larger: ${alt}`}
      >
        <img src={src} alt={alt} class={className} />
      </button>
    ) : (
      <img src={src} alt={alt} class={className} />
    )
  }
</div>

<style>
  .zoom-frame {
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow: hidden;
    border-radius: 1rem;
  }
  .zoom-open {
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: zoom-in;
  }
  .zoom-open:focus-visible {
    outline: 3px solid #faab6b;
    outline-offset: -3px;
    border-radius: 1rem;
  }
  .zoom-frame img {
    display: block;
    transform-origin: 50% 50%;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .zoom-frame:hover img {
      transform: scale(var(--zoom));
    }
  }
</style>

<style is:global>
  .zoom-lightbox {
    width: 100vw;
    height: 100vh;
    width: 100dvw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(12, 10, 9, 0.95);
    overflow: hidden;
  }
  .zoom-lightbox::backdrop {
    background: transparent;
  }
  .zoom-lightbox[open] {
    display: block;
    animation: zoom-lightbox-in 0.3s ease;
  }
  .zoom-lightbox img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    cursor: zoom-out;
  }
  .zoom-lightbox-close {
    position: fixed;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .zoom-lightbox-close:hover,
  .zoom-lightbox-close:focus-visible {
    background: rgba(255, 255, 255, 0.28);
  }
  .zoom-lightbox.is-closing {
    animation: zoom-lightbox-out 0.25s ease forwards;
  }
  @keyframes zoom-lightbox-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes zoom-lightbox-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .zoom-lightbox[open],
    .zoom-lightbox.is-closing {
      animation: none;
    }
  }
</style>

<script>
  let dialog: HTMLDialogElement | null = null;
  let dialogImg: HTMLImageElement | null = null;

  let closing = false;

  const closeDialog = () => {
    if (!dialog || !dialog.open || closing) return;
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (reduce) {
      dialog.close();
      return;
    }
    closing = true;
    dialog.classList.add("is-closing");
    const finish = () => {
      dialog!.classList.remove("is-closing");
      dialog!.close();
      closing = false;
    };
    dialog.addEventListener("animationend", finish, { once: true });
  };

  const getDialog = () => {
    if (dialog && dialogImg) return { dialog, dialogImg };

    dialog = document.createElement("dialog");
    dialog.className = "zoom-lightbox";
    dialog.setAttribute("aria-label", "Enlarged image");

    dialogImg = document.createElement("img");

    const close = document.createElement("button");
    close.type = "button";
    close.className = "zoom-lightbox-close";
    close.setAttribute("aria-label", "Close");
    close.innerHTML =
      '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';

    dialog.append(dialogImg, close);
    document.body.appendChild(dialog);

    dialog.addEventListener("click", () => closeDialog());
    dialog.addEventListener("cancel", (e) => {
      e.preventDefault();
      closeDialog();
    });
    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
    });

    return { dialog, dialogImg };
  };

  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>(
      "[data-zoom-open]",
    );
    if (!trigger) return;
    const img = trigger.querySelector("img");
    if (!img) return;

    const { dialog, dialogImg } = getDialog();
    dialogImg.src = img.currentSrc || img.src;
    dialogImg.alt = img.alt;
    document.body.style.overflow = "hidden";
    dialog.showModal();
  });

  document.addEventListener("pointermove", (e) => {
    const frame = (e.target as HTMLElement).closest<HTMLElement>("[data-zoom]");
    if (!frame) return;
    const img = frame.querySelector("img");
    if (!img) return;
    const rect = frame.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;
    img.style.transformOrigin = `${x}% ${y}%`;
  });
</script>
