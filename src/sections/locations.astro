---
import damascus from "../assets/images/damascus.webp";
import dubai from "../assets/images/dubai.jpg";
import doha from "../assets/images/doha.jpg";
import bahrain from "../assets/images/bahrain.jpg";
import cairo from "../assets/images/cairo.jpg";
import riyadh from "../assets/images/riyadh.jpg";
import jeddah from "../assets/images/jeddah.avif";
import dammam from "../assets/images/dammam.webp";

const locations = [
  {
    name: "Doha",
    company: "Bio Alpha for Trading Medical Devices and Products W.L.L",
    image: doha,
    location:
      "Rawdat AL Khalil, Street #840, Zone #24, Concord Building number 20, Office 14, Doha, Qatar",
  },
  {
    name: "Dubai",
    company: "Bio Alpha Medical Equipment Trading L.L.C",
    image: dubai,
    location:
      "Warehouse 9-Valtrans Warehouses, Al yalayis street, Dubai Investments Park 2",
  },
  {
    name: "Riyadh",
    company: "",
    image: riyadh,
    location: "",
  },
  {
    name: "Jeddah",
    company: "",
    image: jeddah,
    location: "",
  },
  {
    name: "Dammam",
    company: "",
    image: dammam,
    location: "",
  },
];

const subDistributors = [
  {
    name: "Bahrain",
    company: "ESNAD General Trading W.L.L",
    image: bahrain,
    location:
      "Office 12, Building 1237, Road 4618, Block 346, Sea Front Manama, Kingdom of Bahrain",
  },
  {
    name: "Damascus",
    company: "German Renewable Center Limited Liability Company L.L.C",
    image: damascus,
    location:
      "Salhieh, facing Ministry of Economy, Tubi and Salou Building, real estate# 2180/24, Salhieh Jadeh, Damascus, Syria",
  },
  {
    name: "Cairo",
    company: "Egyptian International for Medical Supplies (EIMS)",
    image: cairo,
    location: "12 Omar Ibn AL Khatab, Nasr City, Cairo",
  },
];

const groups = [
  { title: "Offices", items: locations },
  { title: "Sub Distributors", items: subDistributors },
];
---

<section class="w-full bg-primary-black mb-0 xl:mb-24">
  <div
    class="m-auto flex max-w-368 flex-col items-center gap-12 px-4 py-16 sm:px-6 md:px-8"
  >
    <div class="w-full text-center">
      <h1 class="mb-4 text-4xl font-bold text-bg">Our Locations</h1>
      <p class="text font-medium text-offwhite opacity-70">
        We provide premium injectables and full-service support to clinics and
        distributors across the Middle East and North Africa.
      </p>
    </div>

    {
      groups.map((group, ind) => (
        <div class="w-full">
          <h2 class="mb-6 text-center text-3xl font-bold text-bg">
            {group.title}
          </h2>

          <div class="flex flex-wrap justify-center gap-6 lg:gap-8">
            {group.items.map((item) => (
              <div class="group relative isolate h-72 w-full max-w-sm overflow-hidden rounded-2xl sm:w-80 lg:w-96">
                <img
                  src={item.image.src}
                  alt={`${item.name} location`}
                  loading="lazy"
                  class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
                />

                <div
                  class="absolute inset-0 -z-10 bg-linear-to-t from-primary-black via-primary-black/80 via-40% to-transparent to-65%"
                  aria-hidden="true"
                />

                <div class="absolute inset-x-0 bottom-0 flex flex-col p-6 text-left">
                  <h3 class="text-3xl font-bold text-bg">{item.name}</h3>
                  <p class="mt-2 font-semibold text-primary-orange">
                    {item.company}
                  </p>

                  <div
                    class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 group-hover:grid-rows-[1fr] 
        group-hover:opacity-100 group-focus-within:grid-rows-[1fr] group-focus-within:opacity-100 pointer-coarse:grid-rows-[1fr] pointer-coarse:opacity-100 motion-reduce:transition-none"
                  >
                    <p class="overflow-hidden pt-2 text-md font-medium text-offwhite ">
                      {item.location}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
          {ind < groups.length - 1 && (
            <div class="w-full bg-[#332d2a] h-1 mt-10 rounded-full" />
          )}
        </div>
      ))
    }
  </div>
</section>
