---
import aboutUsImage from "../assets/images/about-home.png";
import AppButton from "../components/AppButton.astro";
import visionIcon from "../assets/icons/vision.svg";
import missionIcon from "../assets/icons/mission.svg";
import Reveal from "../components/Reveal.astro";

const listItems = [
  { title: "Countries Server", value: 8 },
  { title: "Happy Clients", value: 200 },
  { title: "Other Stats", value: 15 },
];

const cardsDetails = [
  {
    title: "Our Mission",
    text: `To help shape an aesthetic industry where scientific progress translates into thoughtful treatment choices, confident practitioners, and greater patient trust.`,
    icon: missionIcon,
  },
  {
    title: "Our Vision",
    text: `Bio Alpha brings promising injectable technologies into clinical practice through selective sourcing and close collaboration with healthcare professionals. We help practitioners understand each product’s capabilities, integrate it responsibly into their services, and receive dependable support throughout the partnership.`,
    icon: visionIcon,
  },
];
---

<section class="w-full m-auto bg-bg relative pb-8 overflow-x-hidden">
  <div class="h-28"></div>

  <div class="w-full max-w-368 m-auto">
    <div
      class="lg:w-8/12 w-full lg:px-0 px-8 m-auto mb-12 flex lg:flex-row flex-col z-50 gap-12"
    >
      <Reveal animation="fade-left" delay={150}>
        <img
          src={aboutUsImage.src}
          class="w-[80%] min-w-96 h-fit drop-shadow-xl"
          alt="About us"
          data-
        />
      </Reveal>
      <div>
        <div class="md:h-4"></div>
        <Reveal animation="fade-left">
          <h1 class="text-4xl font-bold mb-5" data->
            Welcome to <span class="text-primary-orange">Bio Alpha</span>
          </h1>
        </Reveal>
        <Reveal animation="fade-left" delay={200}>
          <p
            class="text-lg font-medium text-secondary-black mb-4"
            style="--delay: 100ms"
            data-
          >
            Bio Alpha Medical Equipment Trading specializes in the supply and
            distribution of innovative aesthetic dermal injectables, connecting
            healthcare professionals with advanced solutions that support the
            evolving needs of aesthetic medicine.
          </p>
        </Reveal>

        <Reveal animation="fade-left" delay={400}>
          <p
            class="text-lg mb-12 font-medium text-secondary-black mb-4"
            style="--delay: 200ms"
            data-
          >
            Our distinctive portfolio is backed by efficient supply chain
            management, comprehensive training programs, strategic marketing
            support, and responsive after-sales service. Through our growing
            network across the GCC and wider MENA region, we build lasting
            partnerships founded on product quality, professional expertise, and
            a commitment to patient safety.
          </p>
        </Reveal>
        <!-- <div class="" style="--delay: 400ms" data->
          <AppButton
            text="View products"
            href="/products"
            textColor="text-primary-black"
          />
        </div> -->
      </div>
    </div>
    <div
      class="grid lg:grid-cols-2 grid-cols-1 max-w-5xl mx-auto w-full px-8 gap-8"
    >
      {
        cardsDetails.map((item, ind) => (
          // <div
          //   class={`p-6 rounded-2xl   transition-all ${ind == 0 ? "bg-primary-black text-bg" : "bg-primary-orange text-primary-white"} group`}
          // >
          <div
            class={`p-6 rounded-2xl duration-300 hover:-translate-3  hover:shadow-md  transition-all   group`}
          >
            <div class="flex gap-2 items-center">
              <div
                class={`p-3 size-16 rounded-2xl ${ind == 0 ? "bg-primary-orange" : "bg-primary-black"} flex justify-center items-center`}
              >
                <img src={item.icon.src} class="" alt={`${item.title} icon`} />
              </div>
              <h3 class="text-xl  font-bold">{item.title}</h3>
            </div>
            <p class="mt-3  px-2">{item.text}</p>
          </div>
        ))
      }
    </div>
    <!-- <div
      class="flex md:flex-row flex-col md:gap-0 gap-4 justify-center items-center"
    >
      {
        listItems.map((item, i) => (
          <div
            class=" mx-4 md:min-w-[15%] md:w-auto w-96  cursor-default"
            style={`--delay: ${i * 150}ms`}
            data-
          >
            <div class="group text-center rounded-xl border border-primary-orange bg-white px-6 py-6 transition-all duration-300 ease-out hover:bg-primary-orange hover:scale-105">
              <h3
                class="text-2xl font-bold text-primary-orange transition-colors duration-300 group-hover:text-white"
                data-count={item.value}
              >
                {item.value}
              </h3>
              <p class="text-secondary-black transition-colors duration-300 group-hover:text-white">
                {item.title}
              </p>
            </div>
          </div>
        ))
      }
    </div> -->
  </div>
</section>
