---
import bg from "../../../assets/images/powerfill-bg.png";
import documentIcon from "../../../assets/icons/document-white.png";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import AppButton from "../../../components/AppButton.astro";
import ProductSpecs from "../../../components/ProductSpecs.astro";
import brochure from "../../../assets/brochures/PowerFill brochure.pdf";
import logo from "../../../assets/images/powerfill-logo.png";

const productSpecs = [
  { name: "Product Type", value: "Injectable filler / collagen stimulator" },
  { name: "Vial Strength", value: "1000mg" },
  { name: "Duration", value: "Up to 24 months" },
  { name: "Treatment Frequency", value: "1 - 2 sessions" },
  { name: "Key Component", value: "PDLLA (Poly-D,L-Lactic Acid)" },
  { name: "Manufacturer", value: "REGEN Biotech, Inc." },
];
---

<Layout title="PowerFill | Bio Alpha" navColor="powerfill">
  <div class="w-full">
    <div
      class="w-full flex relative overflow-hidden xl:flex-row flex-col-reverse justify-between"
    >
      <div class="px-[5vw] mt-12 py-24 max-w-4xl text-xl z-10">
        <div class="">
          <!-- <Breadcrumb items={[
        { label: "Home", href: "/" },
        { label: "Products", href: "/products" },
        { label: "powerfill" },
    ]} /> -->
        </div>
        <img
          src={logo.src}
          alt="PowerFill logo"
          class="w-72 animate-hero-delayed-1"
        />
        <p class="mt-4 mb-10 animate-hero-delayed">
          PowerFill® is an injectable collagen biostimulator developed by REGEN
          Biotech for body contour enhancement and soft-tissue augmentation.
          Formulated with poly-D, L-lactic acid (PDLLA), it combines a filling
          effect with stimulation of the body’s natural collagen production,
          supporting progressive volume enhancement. As the biodegradable PDLLA
          particles gradually break down, newly formed collagen contributes to
          tissue support and volume maintenance. PowerFill offers healthcare
          professionals an option for personalized contouring treatments, with
          suitability determined through clinical assessment to treat buttocks
          and body augmentation indications.
        </p>

        <div class="flex gap-5">
          <AppButton
            text="Download Brochure"
            height="h-16"
            bgColor="bg-powerfill"
            width="w-64"
            href={brochure}
            download={true}
            ><icon>
              <img
                class="w-6 inline mx-2"
                src={documentIcon.src}
                alt="Document Icon"
              /></icon
            ></AppButton
          >
          <AppButton
            text="Contact Us"
            height="h-16"
            bgColor="bg-white"
            textColor="text-powerfill"
            border={true}
            width="w-64"
            href="/contact"
          />
        </div>
      </div>

      <img
        src={bg.src}
        class="xl:w-[40rem] xl:block hidden mt-14 lx:mx-0 h-fit w-full slide-right-left"
        alt="powerfill Background"
      />
      <img
        src={bg.src}
        class="absolute inset-0 w-full object-cover opacity-20 xl:hidden pointer-events-none"
        alt=""
      />
    </div>
  </div>
  <div class="w-full lg:max-w-7xl m-auto px-8">
    <div class="w-full lg:px-0 mb-12 m-auto">
      <ProductSpecs specs={productSpecs} color={"powerfill"} />
    </div>

    <div
      class="w-full m-auto bg-white border border-powerfill rounded-2xl p-8 mb-12 flex
    items-center justify-between md:flex-row flex-col-reverse md:gap-0 gap-4"
    >
      <div>
        <p class="font-bold text-xl text-center text-powerfill">
          Download brochure to view full product details
        </p>
        <div class="md:h-14"></div>

        <AppButton
          bgColor="bg-powerfill"
          text="Download"
          className="mt-4 m-auto md:m-0"
          width="w-54"
          href={brochure}
          download={true}
        />
      </div>
      <svg
        version="1.1"
        class={`fill-powerfill size-44`}
        id="_x32_"
        xmlns="http://www.w3.org/2000/svg"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        viewBox="0 0 512 512"
        xml:space="preserve"
        fill="#000000"
        ><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
          id="SVGRepo_tracerCarrier"
          stroke-linecap="round"
          stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier">
          <style type="text/css"></style>
          <g>
            <path
              class="st0"
              d="M378.41,0H208.294h-13.176l-9.314,9.314L57.017,138.102l-9.315,9.314v13.176v265.513 c0,47.361,38.528,85.896,85.896,85.896H378.41c47.36,0,85.888-38.535,85.888-85.896V85.895C464.298,38.528,425.77,0,378.41,0z M432.494,426.104c0,29.877-24.214,54.092-54.084,54.092H133.598c-29.877,0-54.091-24.215-54.091-54.092V160.591h83.717 c24.884,0,45.07-20.179,45.07-45.07V31.804H378.41c29.87,0,54.084,24.214,54.084,54.091V426.104z"
            ></path>
            <rect x="277.446" y="93.17" class="st0" height="89.373"></rect>
            <rect
              x="145.175"
              y="232.592"
              class="st0"
              width="221.644"
              height="25.024"></rect>
            <rect
              x="145.175"
              y="304.09"
              class="st0"
              width="221.644"
              height="25.024"></rect>
            <rect
              x="145.175"
              y="375.588"
              class="st0"
              width="221.644"
              height="25.024"></rect>
          </g>
        </g></svg
      >
    </div>

    <div
      class="w-full m-auto bg-primary-black rounded-2xl p-8 mb-12 flex
    items-center justify-between md:flex-row flex-col md:gap-0 gap-4"
    >
      <div>
        <h1 class="mb-2 text-3xl font-bold text-bg">
          Want to learn more about PowerFill?
        </h1>
        <p class="text-bg opacity-80">We're here to provide help at any time</p>
      </div>
      <AppButton
        text="Contact us"
        href="/contact"
        textColor="text-primary-black"
        bgColor="bg-primary-orange"
      />
    </div>
  </div>
</Layout>
