        </svg>
        <p class="mt-4 mb-10 text">
          JUVEGEL is a dermal filler range featuring a patented combination of
          crosslinked hyaluronic acid (HA) and salmon-derived polynucleotides
          (PN), designed to enhance soft-tissue volume and improve the
          appearance of nasolabial folds. Available in Fine, Classic 01, and
          Volume, each supplied in a 1.0 mL pre-filled syringe. JUVEGEL offers
          healthcare professionals a range of formulations for personalized
          treatment planning, supported by clinical evaluation and a commitment
          to product quality, patient safety, and applicable international
          quality and regulatory standards.
        </p>
        <div class="flex gap-5">
          <AppButton
            text="Download Brochure"
            height="h-16"
            bgColor="bg-juvegel"
            width="w-64"
            href={brochure}
            download={true}
            ><icon>
              <img
                class="w-6 inline mx-2"
                src={documentIcon.src}
                alt="Document Icon"
              /></icon
            ></AppButton
          >
          <AppButton
            text="Contact Us"
            height="h-16"
            bgColor="bg-white"
            textColor="text-juvegel"
            border={true}
            width="w-64"
            href="/contact"
          />
        </div>
      </div>

      <img
        src={bg.src}
        class="lg:w-[40%] h-fit mt-20 w-full slide-right-left"
        alt="juvegel Background"
        class="h-auto max-h-125"
      />
    </div>
    <div class="w-full lg:max-w-7xl m-auto px-8">
      <div class="w-full lg:px-0 mb-12 m-auto">
        <ProductSpecs specs={productSpecs} color={"juvegel"} />
      </div>

      <div
        class="w-full m-auto bg-white border border-juvegel rounded-2xl p-8 mb-12"
      >
        <h2 class="font-bold text-3xl text-juvegel mb-8">Results</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            results.map((result, i) => (
              <BeforeAfterSlider
                before={result.before}
                color={"juvegel"}
                after={result.after}
                alt={`Juvegel result, example ${i + 1}`}
              />
            ))
          }
        </div>
      </div>
      <div
        class="w-full m-auto bg-white border border-juvegel rounded-2xl p-8 mb-12 flex
    items-center justify-between md:flex-row flex-col-reverse md:gap-0 gap-4"
      >
        <div>
          <p class="font-bold text-xl text-center text-juvegel">
            Download brochure to view full product details
          </p>
          <div class="md:h-14"></div>

          <AppButton
            bgColor="bg-juvegel"
            text="Download"
            className="mt-4 m-auto md:m-0"
            width="w-54"
            href={brochure}
            download={true}
          />
        </div>
        <svg
          version="1.1"
          class={`fill-juvegel size-44`}
          id="_x32_"
          xmlns="http://www.w3.org/2000/svg"
          xmlns:xlink="http://www.w3.org/1999/xlink"
          viewBox="0 0 512 512"
          xml:space="preserve"
          fill="#000000"
          ><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
            id="SVGRepo_tracerCarrier"
            stroke-linecap="round"
            stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier">
            <style type="text/css"></style>
            <g>
              <path
                class="st0"
                d="M378.41,0H208.294h-13.176l-9.314,9.314L57.017,138.102l-9.315,9.314v13.176v265.513 c0,47.361,38.528,85.896,85.896,85.896H378.41c47.36,0,85.888-38.535,85.888-85.896V85.895C464.298,38.528,425.77,0,378.41,0z M432.494,426.104c0,29.877-24.214,54.092-54.084,54.092H133.598c-29.877,0-54.091-24.215-54.091-54.092V160.591h83.717 c24.884,0,45.07-20.179,45.07-45.07V31.804H378.41c29.87,0,54.084,24.214,54.084,54.091V426.104z"
              ></path>
              <rect x="277.446" y="93.17" class="st0" height="89.373"></rect>
              <rect
                x="145.175"
                y="232.592"
                class="st0"
                width="221.644"
                height="25.024"></rect>
              <rect
                x="145.175"
                y="304.09"
                class="st0"
                width="221.644"
                height="25.024"></rect>
              <rect
                x="145.175"
                y="375.588"
                class="st0"
                width="221.644"
                height="25.024"></rect>
            </g>
          </g></svg
        >
      </div>

      <div
        class="w-full m-auto bg-primary-black rounded-2xl p-8 mb-12 flex
    items-center justify-between md:flex-row flex-col md:gap-0 gap-4"
      >
        <div>
          <h1 class="mb-2 text-3xl font-bold text-bg">
            Want to learn more about Juvegel?
          </h1>
          <p class="text-bg opacity-80">
            We're here to provide help at any time
          </p>
        </div>
        <AppButton
          text="Contact us"
          href="/contact"
          textColor="text-primary-black"
          bgColor="bg-primary-orange"
        />
      </div>
    </div>
  </div>
</Layout>
