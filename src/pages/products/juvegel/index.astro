          ></polygon>
          <path
            class="cls-1"
            d="M41.27,85.45v17.88c0,19.34,7.23,31.69,24.01,31.69,14.22,0,24.47-11.65,24.47-36.12V9.41h38.22v85.76c0,46.84-22.37,69.92-61.53,69.92S7.71,143.42,7.71,104.96v-19.51h33.56Z"
          ></path>
          <path
            class="cls-1"
            d="M1050.09,32.34c3,0,4.05-1.23,4.05-3.62,0-2.21-.92-3.55-4.36-3.55h-4.42v7.18h4.73ZM1040.89,21.12h8.89c5.89,0,8.83,2.76,8.83,6.99,0,2.76-.74,4.6-2.94,5.7v.13c2.27.92,2.94,2.64,2.94,4.84v7.67h-4.48v-7.42c0-1.96-.8-3.01-3.13-3.01h-5.64v10.42h-4.47v-25.33ZM1069.11,34.06c0-13-9.14-21.28-19.44-21.28s-19.38,8.28-19.38,21.28,9.08,21.28,19.38,21.28,19.44-8.28,19.44-21.28M1027.03,34.06c0-14.72,10.55-24.47,22.63-24.47s22.63,9.75,22.63,24.47-10.55,24.47-22.63,24.47-22.63-9.75-22.63-24.47"
