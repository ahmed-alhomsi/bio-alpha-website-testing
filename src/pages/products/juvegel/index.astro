---
import bg from "../../../assets/images/juvegel-bg.png";
import documentIcon from "../../../assets/icons/document-white.png";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import AppButton from "../../../components/AppButton.astro";
import ProductSpecs from "../../../components/ProductSpecs.astro";

import dangerIcon from "../../../assets/icons/danger.svg";
import checkIcon from "../../../assets/icons/check.svg";
import before1 from "../../../assets/images/b&a/juvegel-before-1.png";
import after1 from "../../../assets/images/b&a/juvegel-after-1.png";
import before2 from "../../../assets/images/b&a/juvegel-before-2.png";
import after2 from "../../../assets/images/b&a/juvegel-after-2.png";
import before3 from "../../../assets/images/b&a/juvegel-before-3.png";
import after3 from "../../../assets/images/b&a/juvegel-after-3.png";
import before4 from "../../../assets/images/b&a/juvegel-before-4.png";
import after4 from "../../../assets/images/b&a/juvegel-after-4.png";
import before5 from "../../../assets/images/b&a/juvegel-before-5.png";
import after5 from "../../../assets/images/b&a/juvegel-after-5.png";
import brochureIcon from "../../../assets/icons/document.svg";
import brochure from "../../../assets/brochures/Juvegel brochure.pdf";
import ZoomImage from "../../../components/ZoomImage.astro";
import BeforeAfterSlider from "../../../components/BeforeAfterSlider.astro";

const productSpecs = [
  { name: "Classification", value: "Dermal filler" },
  { name: "Shelf Life", value: "3 years from manufacturing date" },
  { name: "Packaging", value: "1 mL syringe per box" },
  { name: "Duration", value: "Effective and safe over 24 weeks" },
  {
    name: "Key Components",
    value: "Hyaluronic Acid (HA), Polynucleotide (PN)",
  },
  { name: "Manufacturer", value: "BNC Korea, Inc." },
];

const results = [
  { before: before1, after: after1 },
  { before: before2, after: after2 },
  { before: before3, after: after3 },
  { before: before4, after: after4 },
  { before: before5, after: after5 },
];
---

<Layout title="Juvegel | Bio Alpha" navColor="juvegel">
  <div class="w-full">
    <div class="w-full flex lg:flex-row flex-col-reverse justify-between">
      <div
        class="px-[5vw] lg:mt-12 lg:py-24 py-12 max-w-3xl text-xl animate-hero-delayed"
      >
        <div class="">
          <!-- <Breadcrumb items={[
        { label: "Home", href: "/" },
        { label: "Products", href: "/products" },
        { label: "juvegel" },
    ]} /> -->
        </div>

        <!--?xml version="1.0" encoding="UTF-8"?-->
        <svg
          id="Layer_1"
          data-name="Layer 1"
          class="w-72"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 1080 171.65"
        >
          <defs>
            <style>
              .cls-1 {
                fill: #31564f;
              }
            </style>
          </defs>
          <path
            class="cls-1"
            d="M148.57,103.33V9.41h38.22v92.52c0,20.97,14.22,31.46,34.49,31.46s34.5-10.49,34.5-31.46V9.41h33.79v93.92c0,39.15-27.5,61.76-70.38,61.76s-70.61-22.61-70.61-61.76"
