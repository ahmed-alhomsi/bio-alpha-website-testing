---
import Layout from "../layouts/Layout.astro";
import sendIcon from "../assets/icons/send-black.svg";
import phoneIcon from "../assets/icons/phone-orange.svg";
import emailIcon from "../assets/icons/email-orange.svg";
import locationIcon from "../assets/icons/location-orange.svg";
import AppButton from "../components/AppButton.astro";
import Reveal from "../components/Reveal.astro";

import fAe from "flag-icons/flags/4x3/ae.svg";
import fSa from "flag-icons/flags/4x3/sa.svg";
import fQa from "flag-icons/flags/4x3/qa.svg";
import fKw from "flag-icons/flags/4x3/kw.svg";
import fBh from "flag-icons/flags/4x3/bh.svg";
import fOm from "flag-icons/flags/4x3/om.svg";
import fJo from "flag-icons/flags/4x3/jo.svg";
import fLb from "flag-icons/flags/4x3/lb.svg";
import fEg from "flag-icons/flags/4x3/eg.svg";
import fIq from "flag-icons/flags/4x3/iq.svg";
import fTr from "flag-icons/flags/4x3/tr.svg";
import fIr from "flag-icons/flags/4x3/ir.svg";
import fCy from "flag-icons/flags/4x3/cy.svg";
import fGr from "flag-icons/flags/4x3/gr.svg";
import fGb from "flag-icons/flags/4x3/gb.svg";
import fDe from "flag-icons/flags/4x3/de.svg";
import fFr from "flag-icons/flags/4x3/fr.svg";
import fIt from "flag-icons/flags/4x3/it.svg";
import fEs from "flag-icons/flags/4x3/es.svg";
import fRu from "flag-icons/flags/4x3/ru.svg";
import fUs from "flag-icons/flags/4x3/us.svg";
import fCa from "flag-icons/flags/4x3/ca.svg";
import fBr from "flag-icons/flags/4x3/br.svg";
import fIn from "flag-icons/flags/4x3/in.svg";
import fPk from "flag-icons/flags/4x3/pk.svg";
import fCn from "flag-icons/flags/4x3/cn.svg";
import fKr from "flag-icons/flags/4x3/kr.svg";
import fAu from "flag-icons/flags/4x3/au.svg";

const contactList = [
  { name: "Phone", value: "+971 52 538 5370", icon: phoneIcon },
  { name: "Email", value: "Info@Bio-Alpha.me", icon: emailIcon },
  {
    name: "Location",
    value: "Warehouse 09 , Al Yalayis street, DIP 2  Dubai, UAE",
    icon: locationIcon,
  },
];

const countries = [
  { iso: "ae", name: "United Arab Emirates", code: "+971", flag: fAe },
  { iso: "sa", name: "Saudi Arabia", code: "+966", flag: fSa },
  { iso: "qa", name: "Qatar", code: "+974", flag: fQa },
  { iso: "kw", name: "Kuwait", code: "+965", flag: fKw },
  { iso: "bh", name: "Bahrain", code: "+973", flag: fBh },
  { iso: "om", name: "Oman", code: "+968", flag: fOm },
  { iso: "jo", name: "Jordan", code: "+962", flag: fJo },
  { iso: "lb", name: "Lebanon", code: "+961", flag: fLb },
  { iso: "eg", name: "Egypt", code: "+20", flag: fEg },
  { iso: "iq", name: "Iraq", code: "+964", flag: fIq },
  { iso: "tr", name: "Turkey", code: "+90", flag: fTr },
  { iso: "ir", name: "Iran", code: "+98", flag: fIr },
  { iso: "cy", name: "Cyprus", code: "+357", flag: fCy },
  { iso: "gr", name: "Greece", code: "+30", flag: fGr },
  { iso: "gb", name: "United Kingdom", code: "+44", flag: fGb },
  { iso: "de", name: "Germany", code: "+49", flag: fDe },
  { iso: "fr", name: "France", code: "+33", flag: fFr },
  { iso: "it", name: "Italy", code: "+39", flag: fIt },
  { iso: "es", name: "Spain", code: "+34", flag: fEs },
  { iso: "ru", name: "Russia", code: "+7", flag: fRu },
  { iso: "us", name: "United States", code: "+1", flag: fUs },
  { iso: "ca", name: "Canada", code: "+1", flag: fCa },
  { iso: "br", name: "Brazil", code: "+55", flag: fBr },
  { iso: "in", name: "India", code: "+91", flag: fIn },
  { iso: "pk", name: "Pakistan", code: "+92", flag: fPk },
  { iso: "cn", name: "China", code: "+86", flag: fCn },
  { iso: "kr", name: "South Korea", code: "+82", flag: fKr },
  { iso: "au", name: "Australia", code: "+61", flag: fAu },
];

const defaultCountry = countries[0];

const inputClass =
  "bg-offwhite rounded-xl px-4 py-2 outline-none border border-transparent focus:border-primary-orange focus:ring-2 focus:ring-primary-orange/30 transition-colors";
---

<Layout title="Contact Us | Bio Alpha">
  <div class="w-full lg:mt-12 py-24 max-w-368 logoBg m-auto">
    <div
      class="flex md:px-24 px-8 justify-between lg:flex-row lg:gap-4 gap-8 flex-col"
    >
      <div class="lg:mt-0 mt-8">
        <div>
          <Reveal delay={150}>
            <h1 class="text-primary-black font-bold text-5xl">
              Get in <span class="text-primary-orange"> Touch </span><br /> with Us
            </h1>
          </Reveal>
          <Reveal delay={300}>
            <p class="text-secondary-black mt-4 text-lg">
              We're here to help you find the right products and support for
              your practice.
            </p>
          </Reveal>
        </div>
        <div class="mt-8 flex flex-col gap-8">
          {
            contactList.map((item, ind) => (
              <Reveal animation="zoom-in" delay={500 + 200 * ind}>
                <div class="flex gap-3">
                  <div class="rounded-2xl p-3 bg-offwhite">
                    <img src={item.icon.src} class="w-7 h-7" alt={item.name} />
                  </div>
                  <div>
                    <h3 class="font-medium opacity-50">{item.name}:</h3>
                    <a
                      href={
                        item.name === "Email"
                          ? `mailto:${item.value}`
                          : item.name === "Phone"
                            ? `tel:${item.value.replace(/\s+/g, "")}`
                            : "https://maps.app.goo.gl/yZVkxZwtgKCo3f536"
                      }
                      class="underline transition-all  hover:text-primary-orange font-bold decoration-primary-orange"
                    >
                      {item.value}
                    </a>
                  </div>
                </div>
              </Reveal>
            ))
          }
        </div>
      </div>

      <Reveal animation="zoom-in">
        <div class="rounded-2xl bg-white p-12">
          <form
            id="contact-form"
            method="post"
            enctype="multipart/form-data"
            novalidate
            class="flex flex-col gap-4"
          >
            <div class="flex md:flex-row flex-col justify-between gap-4">
              <div class="md:w-[45%] w-full">
                <label for="first-name" class="block">First name</label>
                <input
                  maxlength="30"
                  id="first-name"
                  name="firstName"
                  type="text"
                  class:list={[inputClass, " w-full"]}
                  placeholder="Your first name..."
                />
              </div>

              <div class="md:w-[50%] w-full">
                <label for="last-name" class="block">Last name</label>
                <input
                  maxlength="30"
                  id="last-name"
                  name="lastName"
                  type="text"
                  class:list={[inputClass, " w-full"]}
                  placeholder="Your last name..."
                />
              </div>
            </div>

            <div class="w-full">
              <label for="email" class="block">Email</label>
              <input
                maxlength="60"
                id="email"
                name="email"
                type="email"
                class:list={[inputClass, "w-full"]}
                placeholder="example@domain.com"
              />
            </div>

            <div class="w-full">
              <label for="phone" class="block">Phone</label>
              <div class="flex gap-2">
                <div class="relative shrink-0" id="country-picker">
                  <input
                    type="hidden"
                    name="countryCode"
                    id="country-code-input"
                    value={defaultCountry.code}
                  />
                  <button
                    type="button"
                    id="country-trigger"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-label="Country code"
                    class="bg-offwhite rounded-xl px-3 py-2 h-full flex items-center gap-2 outline-none border border-transparent focus:border-primary-orange focus:ring-2 focus:ring-primary-orange/30 transition-colors"
                  >
                    <img
                      id="country-flag"
                      src={defaultCountry.flag.src}
                      alt="flag icon"
                      class="w-6 h-4 object-cover rounded-sm"
                    />
                    <span id="country-label">{defaultCountry.code}</span>
                    <svg
                      class="w-4 h-4 opacity-60 transition-transform"
                      id="country-chevron"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"></path>
                    </svg>
                  </button>

                  <ul
                    id="country-list"
                    role="listbox"
                    class="hidden absolute left-0 top-full mt-2 z-30 w-72 max-h-64 overflow-y-auto bg-white rounded-xl shadow-xl border border-gray-200 py-1"
                  >
                    {
                      countries.map((country) => (
                        <li role="presentation">
                          <button
                            type="button"
                            role="option"
                            aria-selected={country.iso === defaultCountry.iso}
                            data-country-option
                            data-iso={country.iso}
                            data-code={country.code}
                            data-flag={country.flag.src}
                            class="w-full flex items-center gap-3 px-3 py-2 text-left hover:bg-offwhite focus:bg-offwhite outline-none aria-selected:font-bold"
                          >
                            <img
                              src={country.flag.src}
                              alt="flag icon"
                              class="w-6 h-4 object-cover rounded-sm shrink-0"
                              loading="lazy"
                            />
                            <span class="flex-1 truncate">{country.name}</span>
                            <span class="opacity-60">{country.code}</span>
                          </button>
                        </li>
                      ))
                    }
                  </ul>
                </div>

                <input
                  id="phone"
                  name="phone"
                  maxlength="20"
                  type="tel"
                  inputmode="tel"
                  class:list={[inputClass, "w-full min-w-0"]}
                  placeholder="50 123 4567"
                />
              </div>
            </div>

            <div class="w-full">
              <label for="message" class="block">Message</label>
              <textarea
                id="message"
                name="message"
                maxlength="2000"
                rows="6"
                class:list={[inputClass, "w-full max-h-48 min-h-40 resize-y"]}
                placeholder="Share your thoughts with us"></textarea>
            </div>

            <div
              class="w-full"
              id="attachments"
              data-max-files="5"
              data-max-size-mb="10"
              data-accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
            >
              <span class="block">Attach files</span>

              <input
                id="attachments-input"
                name="attachments"
                type="file"
                multiple
                accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
                class="hidden"
              />

              <button
                type="button"
                id="dropzone"
                class="w-full px-12 py-6 border border-dashed border-secondary-black rounded-2xl transition-colors duration-200 hover:border-primary-orange hover:bg-primary-orange/5 focus-visible:border-primary-orange focus-visible:ring-2 focus-visible:ring-primary-orange/30 outline-none"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="size-14 m-auto"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <path
                    d="M12 18V12M12 12L14 14M12 12L10 14M13 3H8.2C7.0799 3 6.51984 3 6.09202 3.21799C5.71569 3.40973 5.40973 3.71569 5.21799 4.09202C5 4.51984 5 5.0799 5 6.2V17.8C5 18.9201 5 19.4802 5.21799 19.908C5.40973 20.2843 5.71569 20.5903 6.09202 20.782C6.51984 21 7.0799 21 8.2 21H15.8C16.9201 21 17.4802 21 17.908 20.782C18.2843 20.5903 18.5903 20.2843 18.782 19.908C19 19.4802 19 18.9201 19 17.8V9M13 3L19 9M13 3V7.4C13 7.96005 13 8.24008 13.109 8.45399C13.2049 8.64215 13.3578 8.79513 13.546 8.89101C13.7599 9 14.0399 9 14.6 9H19"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
                <p class="text-center mt-2 font-medium">Attach Files</p>
                <p class="text-center text-sm text-secondary-black opacity-70">
                  Click here to upload files from your device or drag the files
                  here.
                </p>
                <p
                  class="text-center text-xs text-secondary-black opacity-50 mt-2"
                >
                  Up to 5 files, 10 MB each.
                </p>
              </button>

              <p
                id="attachments-error"
                role="alert"
                class="mt-2 text-sm text-red-600"
              >
              </p>
              <ul id="attachments-list" class="mt-3 flex flex-col gap-2"></ul>
            </div>

            <AppButton
              type="submit"
              text="Send"
              bgColor="bg-primary-orange"
              textColor="text-primary-black"
              className="mt-4"
              isCentered={true}
            >
              <img src={sendIcon.src} alt="send icon" class="size-8 inline" />
            </AppButton>
          </form>
        </div>
      </Reveal>
    </div>
  </div>
</Layout>

<script>
  const picker = document.getElementById("country-picker") as HTMLElement;
  const trigger = document.getElementById(
    "country-trigger",
  ) as HTMLButtonElement;
  const list = document.getElementById("country-list") as HTMLElement;
  const chevron = document.getElementById(
    "country-chevron",
  ) as unknown as SVGElement;
  const flagImg = document.getElementById("country-flag") as HTMLImageElement;
  const label = document.getElementById("country-label") as HTMLElement;
  const hidden = document.getElementById(
    "country-code-input",
  ) as HTMLInputElement;
  const options = Array.from(
    list.querySelectorAll<HTMLButtonElement>("[data-country-option]"),
  );

  const setOpen = (open: boolean) => {
    list.classList.toggle("hidden", !open);
    chevron.classList.toggle("rotate-180", open);
    trigger.setAttribute("aria-expanded", String(open));
    if (open) {
      const selected = options.find(
        (o) => o.getAttribute("aria-selected") === "true",
      );
      (selected ?? options[0]).focus();
      selected?.scrollIntoView({ block: "nearest" });
    }
  };

  const select = (option: HTMLButtonElement) => {
    options.forEach((o) =>
      o.setAttribute("aria-selected", String(o === option)),
    );
    flagImg.src = option.dataset.flag as string;
    label.textContent = option.dataset.code as string;
    hidden.value = option.dataset.code as string;
    setOpen(false);
    trigger.focus();
  };

  trigger.addEventListener("click", () =>
    setOpen(list.classList.contains("hidden")),
  );

  options.forEach((option) =>
    option.addEventListener("click", () => select(option)),
  );

  document.addEventListener("click", (e) => {
    if (!picker.contains(e.target as Node)) setOpen(false);
  });

  picker.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      setOpen(false);
      trigger.focus();
      return;
    }
    if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
    e.preventDefault();
    if (list.classList.contains("hidden")) {
      setOpen(true);
      return;
    }
    const i = options.indexOf(document.activeElement as HTMLButtonElement);
    const next = e.key === "ArrowDown" ? i + 1 : i - 1;
    options[Math.max(0, Math.min(options.length - 1, next))].focus();
  });

  const attachRoot = document.getElementById("attachments") as HTMLElement;
  const fileInput = document.getElementById(
    "attachments-input",
  ) as HTMLInputElement;
  const dropzone = document.getElementById("dropzone") as HTMLButtonElement;
  const errorEl = document.getElementById("attachments-error") as HTMLElement;
  const fileListEl = document.getElementById("attachments-list") as HTMLElement;

  const MAX_FILES = Number(attachRoot.dataset.maxFiles);
  const MAX_SIZE_MB = Number(attachRoot.dataset.maxSizeMb);
  const MAX_SIZE = MAX_SIZE_MB * 1024 * 1024;
  const ALLOWED = (attachRoot.dataset.accept as string).split(",");

  let files: File[] = [];

  const formatSize = (bytes: number) =>
    bytes < 1024 * 1024
      ? `${Math.max(1, Math.round(bytes / 1024))} KB`
      : `${(bytes / 1024 / 1024).toFixed(1)} MB`;

  const syncInput = () => {
    const dt = new DataTransfer();
    files.forEach((f) => dt.items.add(f));
    fileInput.files = dt.files;
  };

  const renderFiles = () => {
    fileListEl.replaceChildren(
      ...files.map((file, i) => {
        const li = document.createElement("li");
        li.className =
          "flex items-center gap-3 bg-offwhite rounded-xl px-4 py-2";

        const name = document.createElement("span");
        name.className = "flex-1 truncate";
        name.textContent = file.name;

        const size = document.createElement("span");
        size.className = "text-sm opacity-60 shrink-0";
        size.textContent = formatSize(file.size);

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className =
          "size-7 shrink-0 rounded-full text-lg leading-none hover:bg-primary-orange hover:text-white focus-visible:bg-primary-orange focus-visible:text-white outline-none transition-colors";
        remove.setAttribute("aria-label", `Remove ${file.name}`);
        remove.textContent = "×";
        remove.addEventListener("click", () => {
          files.splice(i, 1);
          errorEl.textContent = "";
          syncInput();
          renderFiles();
        });

        li.append(name, size, remove);
        return li;
      }),
    );
  };

  const addFiles = (incoming: File[]) => {
    const errors: string[] = [];

    for (const file of incoming) {
      const ext = "." + (file.name.split(".").pop() ?? "").toLowerCase();

      if (!ALLOWED.includes(ext)) {
        errors.push(`${file.name}: file type not supported`);
        continue;
      }
      if (file.size > MAX_SIZE) {
        errors.push(`${file.name}: larger than ${MAX_SIZE_MB} MB`);
        continue;
      }
      if (
        files.some(
          (f) =>
            f.name === file.name &&
            f.size === file.size &&
            f.lastModified === file.lastModified,
        )
      ) {
        continue;
      }
      if (files.length >= MAX_FILES) {
        errors.push(`You can attach up to ${MAX_FILES} files`);
        break;
      }
      files.push(file);
    }

    errorEl.textContent = errors.join(". ");
    syncInput();
    renderFiles();
  };

  const dragClasses = ["border-primary-orange", "bg-primary-orange/10"];

  dropzone.addEventListener("click", () => fileInput.click());

  fileInput.addEventListener("change", () => {
    addFiles(Array.from(fileInput.files ?? []));
  });

  ["dragenter", "dragover"].forEach((type) => {
    dropzone.addEventListener(type, (e) => {
      e.preventDefault();
      dropzone.classList.add(...dragClasses);
    });
  });

  dropzone.addEventListener("dragleave", (e) => {
    if (!dropzone.contains((e as DragEvent).relatedTarget as Node)) {
      dropzone.classList.remove(...dragClasses);
    }
  });

  dropzone.addEventListener("drop", (e) => {
    e.preventDefault();
    dropzone.classList.remove(...dragClasses);
    addFiles(Array.from((e as DragEvent).dataTransfer?.files ?? []));
  });

  const form = document.getElementById("contact-form") as HTMLFormElement;

  const nameRule = (label: string) => (value: string) => {
    const v = value.trim();
    if (!v) return `Please enter your ${label}`;
    if (v.length < 2) return `Your ${label} is too short`;
    if (!/^\p{L}[\p{L}\s'’.-]*$/u.test(v))
      return `Your ${label} contains invalid characters`;
    return "";
  };

  const validators: Record<string, (value: string) => string> = {
    firstName: nameRule("first name"),
    lastName: nameRule("last name"),
    email: (value) => {
      const v = value.trim();
      if (!v) return "Please enter your email";
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v))
        return "Please enter a valid email address";
      return "";
    },
    phone: (value) => {
      const digits = value.replace(/[\s\-().]/g, "");
      if (!digits) return "Please enter your phone number";
      if (!/^\d+$/.test(digits)) return "Use digits only";
      if (digits.length < 6 || digits.length > 14)
        return "Please enter a valid phone number";
      return "";
    },
    message: (value) => {
      const v = value.trim();
      if (!v) return "Please write a message";
      if (v.length < 10) return "Please write at least 10 characters";
      return "";
    },
  };

  type Field = HTMLInputElement | HTMLTextAreaElement;

  const fields = Object.keys(validators).map(
    (name) => form.elements.namedItem(name) as Field,
  );
  const touched = new Set<Field>();
  const errorEls = new Map<Field, HTMLElement>();

  fields.forEach((field) => {
    const container =
      field.name === "phone"
        ? field.parentElement!.parentElement!
        : field.parentElement!;
    const p = document.createElement("p");
    p.id = `${field.id}-error`;
    p.className = "mt-1 w-0 min-w-full text-sm text-red-600 empty:hidden";
    container.append(p);
    errorEls.set(field, p);
    field.setAttribute("aria-describedby", p.id);
  });

  const validate = (field: Field) => {
    const message = validators[field.name](field.value);
    errorEls.get(field)!.textContent = message;
    field.setAttribute("aria-invalid", String(Boolean(message)));
    return !message;
  };

  fields.forEach((field) => {
    field.addEventListener("blur", () => {
      touched.add(field);
      validate(field);
    });
    field.addEventListener("input", () => {
      if (touched.has(field)) validate(field);
    });
  });

  form.addEventListener("submit", (e) => {
    let firstInvalid: Field | null = null;

    fields.forEach((field) => {
      touched.add(field);
      if (!validate(field) && !firstInvalid) firstInvalid = field;
    });

    if (firstInvalid) {
      e.preventDefault();
      (firstInvalid as Field).scrollIntoView({
        behavior: "smooth",
        block: "center",
      });
      (firstInvalid as Field).focus({ preventScroll: true });
    }
  });
</script>

<style>
  input[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    border-color: #ef4444 !important;
    --tw-ring-color: rgb(239 68 68 / 0.3) !important;
  }
</style>
