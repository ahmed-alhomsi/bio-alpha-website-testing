---
import Reveal from "../components/Reveal.astro";
import Layout from "../layouts/Layout.astro";
import AppButton from "../components/AppButton.astro";

import salesIcon from "../assets/icons/sales.png";
import marketingIcon from "../assets/icons/marketing.png";
import trainingIcon from "../assets/icons/training.png";
import logisticsIcon from "../assets/icons/logistics.png";
import regulatoryIcon from "../assets/icons/regulatory.png";
import salesImage from "../assets/images/sales.png";
import marketingImage from "../assets/images/marketing.png";
import trainingImage from "../assets/images/training.png";
import logisticsImage from "../assets/images/logistics.png";
import regulatoryImage from "../assets/images/regulatory.png";

const services = [
  {
    id: "sales",
    title: "Sales",
    description:
      "BIO ALPHA takes a consultative approach to product selection, combining technical knowledge with an understanding of each practice’s priorities. Through personalized recommendations, practical guidance, and attentive follow-up, our team helps healthcare professionals evaluate suitable solutions and build lasting supplier relationships.",
    icon: salesIcon.src,
    image: salesImage.src,
  },
  {
    id: "marketing",
    title: "Marketing",
    description:
      "BIO ALPHA helps aesthetic practices communicate their expertise and connect with their audiences. Our services span market analysis, digital campaigns, graphic design, videography, website development, and printed materials. We also support workshops and educational initiatives, tailoring each activity to the practice’s identity and commercial goals.",
    icon: marketingIcon.src,
    image: marketingImage.src,
  },
  // Training copy expanded to match the other sections; edit as needed.
  {
    id: "training",
    title: "Training",
    description:
      "BIO ALPHA provides practitioner training that supports the safe and effective use of our products. Sessions cover product knowledge, technique, and patient selection, so practitioners feel confident putting what they learn into clinical practice.",
    icon: trainingIcon.src,
    image: trainingImage.src,
  },
  {
    id: "logistics",
    title: "Logistics",
    description:
      "BIO ALPHA coordinates storage, inventory, and delivery to keep products available when our partners need them. Careful handling, appropriate storage conditions, and order tracking help protect product integrity, while efficient distribution supports reliable supply and smooth clinic operations.",
    icon: logisticsIcon.src,
    image: logisticsImage.src,
  },
  {
    id: "regulatory",
    title: "Regulatory",
    description:
      "BIO ALPHA supports responsible market access through product registration, technical documentation review, and coordination with relevant authorities. Our team manages submissions and ongoing approval requirements, helping partners navigate local regulations and maintain accurate product records throughout the product lifecycle.",
    icon: regulatoryIcon.src,
    image: regulatoryImage.src,
  },
];
---

<Layout title="Services | Bio Alpha">
  <main class="w-full max-w-368 m-auto px-6 pt-32 pb-24">
    <header
      class="max-w-3xl mx-auto md:mx-0 lg:ml-[10%] text-center md:text-left"
    >
      <Reveal delay={150}>
        <h1 class="text-primary-black font-bold text-5xl leading-tight">
          Our <span class="text-primary-orange">services</span>
        </h1>
        <div class="mt-3 mx-auto"></div>
      </Reveal>
      <Reveal delay={300}>
        <p class="text-secondary-black mt-3 text-xl max-w-xl">
          One partner, everything you need, from choosing products to keeping
          your clinic supplied.
        </p>
      </Reveal>
    </header>

    <div class="mt-20 flex flex-col gap-20 lg:gap-28 lg:w-[80%] m-auto">
      {
        services.map((service, ind) => {
          const flip = ind % 2 === 1;
          const dark = ind % 2 === 1;
          return (
            <Reveal
              animation={flip ? "fade-left" : "fade-right"}
              threshold={0.25}
            >
              <section
                id={service.id}
                aria-labelledby={`${service.id}-title`}
                class={`group scroll-mt-28 grid items-center gap-8 md:gap-14 md:grid-cols-2 ${flip ? "md:[&>div:first-child]:order-2" : ""}`}
              >
                <div
                  class={`relative flex h-72 md:h-96 items-center justify-center overflow-hidden rounded-3xl p-8 shadow-md ${dark ? "bg-primary-black" : "bg-primary-orange"}`}
                >
                  <div
                    aria-hidden="true"
                    class={`absolute size-64 md:size-80 rounded-full ""}`}
                  />
                  <img
                    src={service.image}
                    alt="services image"
                    class="relative max-h-full w-auto object-contain motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-105"
                  />
                </div>

                <div class="text-left">
                  {/* <div class="mb-5 flex size-14 items-center justify-center rounded-2xl bg-orange-off">
                  <img src={service.icon} alt="" width="32" height="32" class="size-8 object-contain" />
                </div> */}
                  <div class="relative w-fit mb-5">
                    <h2
                      id={`${service.id}-title`}
                      class="text-primary-black group-hover:scale-105 transition-all duration-300 text-4xl font-bold "
                    >
                      {service.title}
                    </h2>
                    <div class="group-hover:w-full w-0 transition-all duration-500 rounded-full  h-1 -bottom-2 relative bg-primary-orange" />
                  </div>
                  <p class="text-secondary-black text-lg leading-relaxed max-w-lg">
                    {service.description}
                  </p>
                </div>
              </section>
            </Reveal>
          );
        })
      }
    </div>

    <Reveal threshold={0.3}>
      <section
        class="mt-28 lg:w-[80%] m-auto rounded-3xl bg-primary-black px-8 py-16 text-center"
      >
        <h2 class="text-white text-3xl md:text-4xl font-bold">
          Get in Touch with Us
        </h2>
        <p class="text-white/80 mt-4 text-lg max-w-xl mx-auto">
          Tell us about your practice and we’ll point you to the right service.
        </p>
        <AppButton
          textSize="text-md"
          className="mt-8 m-auto"
          width="w-64"
          href="/contact"
          text="Contact us"
          textColor="text-primary-black"
          height="h-16"
          bgColor="bg-primary-orange"
        />
      </section>
    </Reveal>
  </main>
</Layout>
